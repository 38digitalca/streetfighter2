{
  "name": "cinder-alley",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cinder Alley — an original two-player browser fighter.",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite --host 127.0.0.1 --port 43123 --strictPort\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/sim.test.ts tests/server.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
